# Servidor
PORT=5050
NODE_ENV=development
API_VERSION=v1

# Conexión Prisma ORM (PostgreSQL)
DATABASE_URL="postgresql://usuario:password@localhost:5432/clase12nov?schema=public"

# Generate a random secret of at least 32 characters for protected API operations.
API_WRITE_KEY=

# Parámetros heredados
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clase12nov
DB_USER=tu_usuario
DB_PASSWORD=tu_password
DB_POOL_MAX=20

# CORS
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://luzu1202.github.io

# Paginación
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
